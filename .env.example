# ─── Claude (Anthropic) API ───────────────────────────────────────────
CLAUDE_API_KEY=your_claude_api_key_here

# ─── Telegram 설정 (선택사항) ──────────────────────────────────────────
# Telegram Bot을 통해 스크래핑 결과를 실시간으로 알림받을 수 있습니다.
#
# 설정 방법:
# 1. Telegram에서 BotFather와 채팅 시작 (/start)
# 2. /newbot 명령으로 새 봇 생성
# 3. 봇 토큰 받기 (TELEGRAM_BOT_TOKEN)
# 4. 사용자 chat_id 확인:
#    - 봇에 /start 메시지 보내기
#    - 웹브라우저에서 확인: https://api.telegram.org/bot{BOT_TOKEN}/getUpdates

TELEGRAM_NOTIFY_ENABLED=false
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── WordPress 블로그 설정 (선택사항) ─────────────────────────────────
# 리포트를 WordPress 블로그에 자동 포스팅합니다.
#
# 설정 방법:
# 1. WordPress 대시보드 → 사용자 → 보안 → 애플리케이션 비밀번호 생성
# 2. XML-RPC 엔드포인트: https://yourblog.wordpress.com/xmlrpc.php

WP_POST_ENABLED=false
WP_ENDPOINT=https://yourblog.wordpress.com/xmlrpc.php
WP_USER=your_wordpress_username
WP_APP_PASSWORD=your_wordpress_app_password
WP_AI_CATEGORY_ID=

# ─── Instagram 설정 (선택사항) ────────────────────────────────────────
# Instagram Business 계정에 뉴스를 자동 포스팅하려면 아래 항목을 채우세요.
#
# 설정 방법:
# 1. Instagram 비즈니스 계정으로 전환
# 2. Meta for Developers에서 앱 생성 (https://developers.facebook.com)
# 3. Instagram Graph API 액세스 토큰 발급
# 4. 비즈니스 계정 ID 확인

INSTAGRAM_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_business_account_id_here
INSTAGRAM_HASHTAGS=#AI #News #TechNews #ArtificialIntelligence

# ─── 기본 설정 ────────────────────────────────────────────────────────
DATA_DIR=data
